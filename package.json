{
  "name": "teapilot-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "TeaPilot monorepo: the teapilot CLI and the packages it ships with",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "teapilot": "packages/teapilot/dist/cli.js"
  },
  "scripts": {
    "start": "node --import tsx --conditions=teapilot-source packages/teapilot/src/cli.ts",
    "doctor": "npm start -- doctor",
    "setup": "npm start -- setup",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "check": "npm run check --workspaces",
    "global:build": "npm run build && npm install --global .",
    "global:pull": "git pull && npm install --allow-git=all --allow-remote=all && npm run global:build",
    "test:package": "npm run test:package -w teapilot",
    "test:ollama": "npm run test:ollama -w teapilot",
    "term": "node packages/teapilot/scripts/agent-terminal.mjs"
  }
}
