{
  "router": {
    "min_confidence": 0.55,
    "allowed_risk_levels": ["low", "medium", "high"],
    "confirmation_risk_levels": ["high", "critical"],
    "require_verified_candidates": true
  },
  "permissions": ["inference", "repository.read", "repository.write", "repository.shell", "web.search", "discord.play"],
  "disabledCapabilities": [],
  "budget": {
    "requestUsd": 1,
    "dailyUsd": 5,
    "approvalThresholdUsd": 0.1
  },
  "limits": {
    "maxTurns": 12,
    "maxToolCalls": 40,
    "attemptTimeoutMs": 900000,
    "requestTimeoutMs": 60000,
    "commandTimeoutSeconds": 120,
    "maxPromptChars": 12000
  },
  "escalation": { "maxEscalations": 3, "consecutiveFailures": 2, "repeatedToolCalls": 3 },
  "execution": { "trustedCommands": [], "largeOverwriteBytes": 65536 }
}
