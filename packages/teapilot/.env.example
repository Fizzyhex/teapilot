# Node >=22.19.0. Secrets stay here; do not commit .env.
# Use direct with explicit ask/code commands for routing without API keys.
# The setup wizard selects direct; existing/manual configs default to hosted.
TEAPILOT_ROUTING_MODE=hosted
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
JEV_API_KEY=
OPENROUTER_API_KEY=
# JEV_MODEL=jev-latest
# OpenRouter uses ~typesafe/jev-latest by default.
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# Conservative maximum charge reserved per Jev call; unknown cost keeps the hold.
JEV_MAX_CALL_USD=0.01
JEV_USD_PER_MILLION_TOKENS=0.042

LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=local-model
LOCAL_API_KEY=
LOCAL_ENABLED=true

# Enable PAYG only after setting model IDs and conservative maximum price rates.
ECONOMY_ENABLED=false
ECONOMY_MODEL=replace-with-your-economy-model
ECONOMY_BASE_URL=https://openrouter.ai/api/v1
ECONOMY_INPUT_USD_PER_MILLION=0
ECONOMY_OUTPUT_USD_PER_MILLION=0
STRONG_ENABLED=false
STRONG_MODEL=replace-with-your-strong-model
STRONG_BASE_URL=https://openrouter.ai/api/v1
STRONG_INPUT_USD_PER_MILLION=0
STRONG_OUTPUT_USD_PER_MILLION=0

REQUEST_BUDGET_USD=1
DAILY_BUDGET_USD=5
# Copy example files to these ignored paths to customize context sizes, permissions,
# exact trusted build/test commands, availability, and escalation thresholds.
# TEAPILOT_MODELS_FILE=config/models.json
# TEAPILOT_POLICY_FILE=config/policy.json
# Default ~/.teapilot shares the daily ledger across repositories.
# TEAPILOT_STATE_DIR=C:/Users/you/.teapilot
# Optional SearXNG instance with JSON enabled; used only with --web.
# SEARCH_BASE_URL=http://127.0.0.1:8888
