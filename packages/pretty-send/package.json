{
  "name": "pretty-send",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Markdown to Discord messages: tables, dividers, inline images and files through Components V2",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "teapilot-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
